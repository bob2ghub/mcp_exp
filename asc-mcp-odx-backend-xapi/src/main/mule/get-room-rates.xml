<?xml version="1.0" encoding="UTF-8"?>
<!--
  T-07 compare_rooms_rates: POST /api/v1/compare-rooms

  2 to 4 room types of ONE property side by side, for one stay and one room's guests. It gathers the rooms only: no
  ranking or recommendation (owner decision 2026-10-26); the model recommends in its reply.

  Request:
    {propertyCode, roomCodes: ["0BRCT", "1DLXT"] (optional, 2 to 4 codes; PRD name roomCategoryCodes also accepted),
     checkinDate | checkin, checkoutDate | checkout, noOfadults | adults, noOfchildren | children, childAges,
     currencyCode | currency, language, priceIncludesTax}
    One room's guests only: an apartmentList with more than one entry (or noOfRooms > 1) is refused.
  Room codes are matched against upstream apartmentType (what T-04 returns as room_code), else apartmentCategoryCode,
  ignoring case. Without roomCodes the property's first four room types are compared.

  Steps:
    compare-rooms-validate-request  dwl/compare-rooms-validate-request.dwl -> vars.roomCodesRequest, then the T-04
                                    validator (multi-rooms-validate-request) -> vars.roomsRequest, then the one-room check
    multi-rooms-get-rates           ONE booking search call for the property (childAges sent upstream) -> vars.roomsSource
    compare-rooms-map-response      dwl/room-rate-details.dwl -> vars.roomsT04 (T-04 structuredContent), then
                                    dwl/compare-rooms-response.dwl -> payload, then the two-room check

  Response: schemas/T07-compare-rooms-rates.structured-content.schema.json 0.4.0 (the owner's file, 2026-10-28):
  {meta, rooms[2..4], excluded[]}. Each room is a T-04 room. excluded[] (left out when empty):
  "not_available" for a requested code with no bookable room type, "over_limit" for the room types past the first four
  when roomCodes was omitted. Fewer than two rooms left: 404 NOT_ENOUGH_ROOMS (the tool's isError, ER-05 / EC-04);
  the message lists the room types that do have rates.

  2026-10-27: this file was T-04 (POST /api/v1/room-details, flow get-room-details). T-04 is now served by
  get-multi-room-rates.xml (POST /api/v1/multi-room-details), whose sub-flows multi-rooms-validate-request and
  multi-rooms-get-rates this flow reuses, so get-multi-room-rates.xml must be deployed with it. The MCP tool
  getRoomAndRateDetails must be moved to /api/v1/multi-room-details before this file is deployed.

  Properties: rooms.maxRooms plus the shared app.*, default.*, request.*, asset.* and property.currency keys.
  Listener: common_HTTP_Listener_Config (global-config.xml).
-->
<mule xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

  <flow name="compare-rooms-rates">
    <http:listener config-ref="common_HTTP_Listener_Config" path="/api/v1/compare-rooms" allowedMethods="POST">
      <http:response statusCode="#[vars.httpStatus default 200]"><http:body><![CDATA[#[output application/json --- payload]]]></http:body><http:headers><![CDATA[#[{'Content-Type': 'application/json', 'X-Correlation-ID': vars.traceId default correlationId}]]]></http:headers></http:response>
      <http:error-response statusCode="#[vars.httpStatus default 500]"><http:body><![CDATA[#[output application/json --- payload]]]></http:body><http:headers><![CDATA[#[{'Content-Type': 'application/json', 'X-Correlation-ID': vars.traceId default correlationId}]]]></http:headers></http:error-response>
    </http:listener>
    <set-variable variableName="traceId" value="#[do { var h = attributes.headers.'x-correlation-id' default '' --- if (h matches /^[A-Za-z0-9_-]{1,80}$/) h else correlationId }]" doc:name="traceId"/>
    <set-variable variableName="startedAt" value="#[now() as Number {unit: 'milliseconds'}]" doc:name="startedAt"/>
    <!-- The shared loggers in get-common-details.xml read vars.toolName. -->
    <set-variable variableName="toolName" value="compare_rooms_rates" doc:name="toolName"/>
    <logger category="ascott.audit" level="INFO" message='#[output text/plain --- write({event: "T07.start", tool: vars.toolName, correlationId: vars.traceId}, "application/json", {indent: false})]' doc:name="T07-START"/>
    <flow-ref name="compare-rooms-validate-request" doc:name="compare-rooms-validate-request"/>
    <!-- get-multi-room-rates.xml: one booking search call, vars.roomsSource = propertyList[0]. -->
    <flow-ref name="multi-rooms-get-rates" doc:name="multi-rooms-get-rates"/>
    <flow-ref name="compare-rooms-map-response" doc:name="compare-rooms-map-response"/>
    <logger category="ascott.audit" level="INFO" message='#[output text/plain --- write({event: "T07.success", tool: vars.toolName, correlationId: vars.traceId, propertyCode: payload.meta.property_code, roomCodes: vars.roomCodesRequest.roomCodes default [], rooms: (payload.rooms default []) map $.room_code, excluded: payload.excluded default [], elapsedMs: (now() as Number {unit: "milliseconds"}) - vars.startedAt}, "application/json", {indent: false})]' doc:name="T07-SUCCESS"/>
    <error-handler ref="compare-rooms-error-handler"/>
  </flow>

  <!-- Room codes -> vars.roomCodesRequest; stay and guests -> vars.roomsRequest (the T-04 validator, which ignores roomCodes).
       The codes are checked first, so a request with bad codes and a bad stay reports the codes first. -->
  <sub-flow name="compare-rooms-validate-request">
    <try>
      <ee:transform doc:name="room codes">
        <ee:variables><ee:set-variable variableName="roomCodesRequest" resource="dwl/compare-rooms-validate-request.dwl"/></ee:variables>
      </ee:transform>
      <error-handler>
        <!-- The real reason is in this ERROR line; the caller only gets "not valid JSON". -->
        <on-error-continue type="MULE:EXPRESSION" logException="true" enableNotifications="false">
          <logger category="ascott.audit" level="ERROR" message="#[output text/plain --- 'compare-rooms-validate-request.dwl failed: ' ++ (error.description default '')]"/>
          <set-variable variableName="roomCodesRequest" value="#[{errors: ['Request body must be valid JSON.'], roomCodes: []}]" doc:name="roomCodesRequest"/>
        </on-error-continue>
      </error-handler>
    </try>
    <choice>
      <when expression="#[not isEmpty(vars.roomCodesRequest.errors default [])]">
        <set-variable variableName="errorMessage" value="#[(vars.roomCodesRequest.errors default []) joinBy ' ']" doc:name="errorMessage"/>
        <raise-error type="APP:BAD_REQUEST" description="Invalid compare_rooms_rates request"/>
      </when>
    </choice>
    <!-- get-multi-room-rates.xml: dwl/rooms-validate-request.dwl plus its noOfRooms check -> vars.roomsRequest. -->
    <flow-ref name="multi-rooms-validate-request" doc:name="multi-rooms-validate-request"/>
    <!-- T-07 compares room types for ONE room's guests (schema 0.4.0 meta.noOfadults / noOfchildren). -->
    <choice>
      <when expression="#[sizeOf(vars.roomsRequest.apartmentList default []) > 1]">
        <set-variable variableName="errorMessage" value="compare_rooms_rates compares room types for one room: send one apartmentList entry, or the guests at the top level." doc:name="errorMessage"/>
        <raise-error type="APP:BAD_REQUEST" description="More than one room"/>
      </when>
    </choice>
  </sub-flow>

  <!-- vars.roomsSource + vars.roomsRequest -> T-04 structuredContent (vars.roomsT04) -> T-07 structuredContent (0.4.0). -->
  <sub-flow name="compare-rooms-map-response">
    <ee:transform doc:name="room-rate-details">
      <ee:variables>
        <ee:set-variable variableName="roomsT04" resource="dwl/room-rate-details.dwl"/>
      </ee:variables>
    </ee:transform>
    <ee:transform doc:name="compare-rooms-response">
      <ee:message>
        <ee:set-payload resource="dwl/compare-rooms-response.dwl"/>
      </ee:message>
    </ee:transform>
    <!-- The schema needs 2 to 4 rooms: fewer is the tool's isError (ER-05, EC-04), naming what is available so the model can retry. -->
    <choice>
      <when expression="#[sizeOf(payload.rooms default []) &lt; 2]">
        <set-variable variableName="errorCode" value="NOT_ENOUGH_ROOMS" doc:name="errorCode"/>
        <set-variable variableName="errorMessage" value="#[do {
	var withRates = (((vars.roomsT04.requested_rooms default [])[0].rooms default []) map ((r) -> r.room_code default '')) filter ((c) -> c != '')
	var missing = ((payload.excluded default []) filter ((x) -> x.reason == 'not_available')) map ((x) -> x.room_code)
	---
	'Fewer than two room types can be compared at property ' ++ (vars.roomsRequest.propertyCode default '') ++ ' for this stay.'
		++ (if (isEmpty(missing)) '' else ' Not available: ' ++ (missing joinBy ', ') ++ '.')
		++ (if (isEmpty(withRates)) ' No room type has a bookable rate.' else ' Room types with rates: ' ++ (withRates joinBy ', ') ++ '.')
}]" doc:name="errorMessage"/>
        <raise-error type="APP:NOT_FOUND" description="Fewer than two rooms to compare"/>
      </when>
    </choice>
  </sub-flow>

  <error-handler name="compare-rooms-error-handler">
    <on-error-propagate type="APP:BAD_REQUEST" logException="false" enableNotifications="false">
      <set-variable variableName="httpStatus" value="#[400]"/>
      <set-variable variableName="publicError" value="#[{category: 'FUNCTIONAL', code: 'BAD_REQUEST', message: vars.errorMessage default 'Invalid request.', retryable: false}]"/>
      <flow-ref name="compare-rooms-format-and-log-error"/>
    </on-error-propagate>
    <on-error-propagate type="APP:NOT_FOUND" logException="false" enableNotifications="false">
      <set-variable variableName="httpStatus" value="#[404]"/>
      <set-variable variableName="publicError" value="#[{category: 'FUNCTIONAL', code: vars.errorCode default 'ROOMS_NOT_FOUND', message: vars.errorMessage default 'No rooms found for this property.', retryable: false}]"/>
      <flow-ref name="compare-rooms-format-and-log-error"/>
    </on-error-propagate>
    <on-error-propagate type="HTTP:TIMEOUT" logException="false" enableNotifications="false">
      <set-variable variableName="httpStatus" value="#[504]"/>
      <set-variable variableName="publicError" value="#[{category: 'TECHNICAL', code: 'DOWNSTREAM_TIMEOUT', message: 'Room and rate service timed out. Retry later.', retryable: true}]"/>
      <flow-ref name="compare-rooms-log-downstream"/>
      <flow-ref name="compare-rooms-format-and-log-error"/>
    </on-error-propagate>
    <!-- A 400 from booking search is its own category: our body was rejected, not the service being down. -->
    <on-error-propagate type="HTTP:BAD_REQUEST" logException="false" enableNotifications="false">
      <set-variable variableName="httpStatus" value="#[502]"/>
      <set-variable variableName="publicError" value="#[{category: 'TECHNICAL', code: 'DOWNSTREAM_REJECTED', message: 'Room and rate service rejected the request. Contact support with the correlation ID.', retryable: false}]"/>
      <flow-ref name="compare-rooms-log-downstream"/>
      <flow-ref name="compare-rooms-format-and-log-error"/>
    </on-error-propagate>
    <on-error-propagate when="#[error.errorType.namespace == 'HTTP']" logException="false" enableNotifications="false">
      <set-variable variableName="httpStatus" value="#[502]"/>
      <set-variable variableName="publicError" value="#[{category: 'TECHNICAL', code: 'DOWNSTREAM_UNAVAILABLE', message: 'Room and rate service unavailable. Contact support with the correlation ID.', retryable: true}]"/>
      <flow-ref name="compare-rooms-log-downstream"/>
      <flow-ref name="compare-rooms-format-and-log-error"/>
    </on-error-propagate>
    <on-error-propagate type="ANY" logException="true" enableNotifications="false">
      <set-variable variableName="httpStatus" value="#[500]"/>
      <set-variable variableName="publicError" value="#[{category: 'TECHNICAL', code: 'INTERNAL_ERROR', message: 'Request failed. Contact support with the correlation ID.', retryable: false}]"/>
      <flow-ref name="compare-rooms-format-and-log-error"/>
    </on-error-propagate>
  </error-handler>

  <!-- The upstream status and body (first 1000 characters), the only place they can be read from. -->
  <sub-flow name="compare-rooms-log-downstream">
    <try>
      <logger category="ascott.audit" level="WARN" message='#[output text/plain --- write({event: "xapi.downstream.error", tool: vars.toolName default "compare_rooms_rates", correlationId: vars.traceId default correlationId, propertyCode: vars.roomsRequest.propertyCode default null, status: error.errorMessage.attributes.statusCode default null, errorType: error.errorType.namespace ++ ":" ++ error.errorType.identifier, detail: error.description, body: do { var b = (if (error.errorMessage.payload is String) error.errorMessage.payload else write(error.errorMessage.payload default "", "application/json", {indent: false})) as String --- if (sizeOf(b) > 1000) b[0 to 999] else b }}, "application/json", {indent: false})]' doc:name="downstream.error"/>
      <error-handler>
        <on-error-continue type="ANY" logException="false" enableNotifications="false">
          <logger category="ascott.audit" level="WARN" message='#[output text/plain --- write({event: "xapi.downstream.error", tool: vars.toolName default "compare_rooms_rates", correlationId: vars.traceId default correlationId, note: "downstream body is not readable"}, "application/json", {indent: false})]'/>
        </on-error-continue>
      </error-handler>
    </try>
  </sub-flow>

  <sub-flow name="compare-rooms-format-and-log-error">
    <logger category="ascott.audit" level="ERROR" message='#[output text/plain --- write({event: "xapi.failure", tool: vars.toolName default "compare_rooms_rates", correlationId: vars.traceId default correlationId, status: vars.httpStatus, category: vars.publicError.category, code: vars.publicError.code, errorType: error.errorType.namespace ++ ":" ++ error.errorType.identifier, detail: error.description}, "application/json", {indent: false})]'/>
    <set-payload value="#[output application/json --- {success: false, correlationId: vars.traceId default correlationId, error: vars.publicError}]"/>
  </sub-flow>
</mule>
