  <flow name="route-findPropertiesByLocation" doc:id="180f63ea-0d9a-40a2-9910-e698d8e06c7a">
    <set-variable variableName="toolName" value="findPropertiesByLocation" doc:name="toolName-findPropertiesByLocation"/>
    <flow-ref name="log-xapi-start" doc:name="log-xapi-start"/>
    <http:request config-ref="MCP-EXP-HTTPconfig" method="CONNECT" path="/findPropertiesByLocation" responseTimeout="${odx.timeout}" requestStreamingMode="NEVER" doc:name="odx-findproperty-call">
      <http:body><![CDATA[#[output application/json --- payload]]]></http:body>
      <http:headers><![CDATA[#[{
'Content-Type': 'application/json', 
'X-Correlation-ID': vars.traceId, 
'Idempotency-Key': payload.idempotencyKey default ''
}]]]></http:headers>
      <http:response-validator><http:success-status-code-validator values="200..299,400,404,409,422"/></http:response-validator>
    </http:request>
    <set-variable variableName="processStatus" value="#[attributes.statusCode]" doc:name="statusCode"/>
    <flow-ref name="check-process-response" doc:name="check-process-response"/>
    <flow-ref name="log-xapi-success" doc:name="log-xapi-success"/>
  </flow>
