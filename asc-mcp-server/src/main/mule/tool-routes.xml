  <sub-flow name="check-process-response">
    <choice><when expression="#[vars.processStatus &gt;= 400]">
      <set-variable variableName="httpStatus" value="#[vars.processStatus]" doc:name="httpStatus"/>
      <raise-error type="APP:FUNCTIONAL" description="Process API business rejection"/>
    </when></choice>
    <set-variable variableName="httpStatus" value="#[vars.processStatus]" doc:name="processStatus"/>
  </sub-flow>
  <sub-flow name="log-xapi-start"><logger category="ascott.audit" level="INFO" message='#[output text/plain --- write({event: "xapi.start", tool: vars.toolName, correlationId: vars.traceId, durationMs: (now() as Number {unit: "milliseconds"}) - vars.startedAt}, "application/json", {indent: false})]' doc:name="Audit Logger"/></sub-flow>
  <sub-flow name="log-xapi-success"><logger category="ascott.audit" level="INFO" message='#[output text/plain --- write({event: "xapi.success", tool: vars.toolName, correlationId: vars.traceId, durationMs: (now() as Number {unit: "milliseconds"}) - vars.startedAt}, "application/json", {indent: false})]' doc:name="sucess Logger"/></sub-flow>
